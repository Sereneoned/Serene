---
/**
 * 桌面端下拉悬挂哈士奇挂件（参考 Sakura 下拉挂绳回到顶部交互）。
 * 页面向下滚动超过阈值时，沿右侧卡缘外侧垂落红黑编织挂绳，
 * 小哈士奇侧抱绳索在右下角留白处轻柔晃动；点击即可平滑返回顶部。
 */
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
---

<button
	type="button"
	id="scroll-husky-btn"
	class="scroll-husky cursor-pointer"
	aria-label={i18n(I18nKey.backToTop)}
	data-ui-i18n-aria-label={I18nKey.backToTop}
	title={i18n(I18nKey.backToTop)}
	aria-hidden="true"
	tabindex="-1"
>
	<span class="scroll-husky__rig">
		<span class="scroll-husky__cord" aria-hidden="true"></span>
		<svg
			class="scroll-husky__pet"
			viewBox="0 0 96 120"
			width="72"
			height="90"
			aria-hidden="true"
		>
			<!-- 绳段无缝衔接顶部 CSS 编织绳（x=82 落在右侧卡片留白处） -->
			<line
				x1="82"
				y1="0"
				x2="82"
				y2="88"
				stroke="#27272a"
				stroke-width="3.2"
				stroke-linecap="round"
			/>
			<line
				x1="82"
				y1="0"
				x2="82"
				y2="88"
				stroke="#dc2626"
				stroke-width="3.2"
				stroke-dasharray="6 5"
			/>
			<circle cx="82" cy="89" r="2.6" fill="#dc2626" stroke="#18181b" stroke-width="1.3" />

			<!-- 后方卷翘哈士奇尾巴 -->
			<path
				d="M28 84 C11 84 6 97 15 106 C23 114 35 109 32 98 C31 93 26 92 23 95"
				fill="#334155"
				stroke="#18181b"
				stroke-width="2.4"
				stroke-linejoin="round"
			/>
			<path
				d="M14 96 C11 101 16 107 22 108 C26 108 29 105 27 100 C24 100 18 98 14 96 Z"
				fill="#ffffff"
			/>

			<!-- Q版小身躯（面向左侧微微斜倚在绳旁） -->
			<ellipse
				cx="47"
				cy="76"
				rx="16.5"
				ry="20.5"
				transform="rotate(8 47 76)"
				fill="#334155"
				stroke="#18181b"
				stroke-width="2.4"
			/>
			<ellipse
				cx="48"
				cy="78"
				rx="10.5"
				ry="15"
				transform="rotate(8 48 78)"
				fill="#ffffff"
			/>

			<!-- 悬空后爪与粉色肉垫 -->
			<ellipse
				cx="36"
				cy="96"
				rx="6.5"
				ry="5"
				transform="rotate(-14 36 96)"
				fill="#ffffff"
				stroke="#18181b"
				stroke-width="2.2"
			/>
			<ellipse
				cx="54"
				cy="98"
				rx="6.5"
				ry="5"
				transform="rotate(14 54 98)"
				fill="#ffffff"
				stroke="#18181b"
				stroke-width="2.2"
			/>
			<circle cx="36" cy="96.5" r="1.5" fill="#fda4af" />
			<circle cx="54" cy="98.5" r="1.5" fill="#fda4af" />

			<!-- 红项圈与金色小铃铛 -->
			<path
				d="M34 59 Q48 65 62 60"
				fill="none"
				stroke="#dc2626"
				stroke-width="4.2"
				stroke-linecap="round"
			/>
			<circle
				cx="50"
				cy="64"
				r="3.4"
				fill="#fbbf24"
				stroke="#18181b"
				stroke-width="1.5"
			/>

			<!-- 抱住右侧绳索的毛绒前爪 -->
			<path
				d="M59 64 Q71 58 80 55"
				fill="none"
				stroke="#18181b"
				stroke-width="7.2"
				stroke-linecap="round"
			/>
			<path
				d="M59 64 Q71 58 80 55"
				fill="none"
				stroke="#ffffff"
				stroke-width="3.6"
				stroke-linecap="round"
			/>
			<ellipse
				cx="82"
				cy="54"
				rx="5.2"
				ry="4.2"
				fill="#ffffff"
				stroke="#18181b"
				stroke-width="2.1"
			/>

			<path
				d="M58 74 Q71 71 80 70"
				fill="none"
				stroke="#18181b"
				stroke-width="7.2"
				stroke-linecap="round"
			/>
			<path
				d="M58 74 Q71 71 80 70"
				fill="none"
				stroke="#ffffff"
				stroke-width="3.6"
				stroke-linecap="round"
			/>
			<ellipse
				cx="82"
				cy="70"
				rx="5.2"
				ry="4.2"
				fill="#ffffff"
				stroke="#18181b"
				stroke-width="2.1"
			/>

			<!-- 哈士奇头部（歪头卖萌） -->
			<g transform="rotate(-5 46 38)">
				<path
					d="M25 14 L34 23 A20 18 0 0 1 58 23 L67 14 C69.5 11.5 73 13 72.5 16.5 L70 30 C72.5 35 73 42 71 48 C67 57 57 62 46 62 C35 62 25 57 21 48 C19 42 19.5 35 22 30 L19.5 16.5 C19 13 22.5 11.5 25 14 Z"
					fill="#334155"
					stroke="#18181b"
					stroke-width="2.4"
					stroke-linejoin="round"
				/>
				<path d="M25.5 18.5 L32 24.5 L26 27.5 Z" fill="#fda4af" />
				<path d="M66.5 18.5 L60 24.5 L66 27.5 Z" fill="#fda4af" />
				<path
					d="M46 26 L49.2 34.5 C51.5 33.5 54.5 34 57.5 35.5 C62.5 38 68.5 42 68.5 48 C68.5 55.5 58.5 60.5 46 60.5 C33.5 60.5 23.5 55.5 23.5 48 C23.5 42 29.5 38 34.5 35.5 C37.5 34 40.5 33.5 42.8 34.5 Z"
					fill="#ffffff"
				/>
				<ellipse
					cx="37.5"
					cy="30.5"
					rx="2.9"
					ry="1.7"
					transform="rotate(-18 37.5 30.5)"
					fill="#ffffff"
				/>
				<ellipse
					cx="54.5"
					cy="30.5"
					rx="2.9"
					ry="1.7"
					transform="rotate(18 54.5 30.5)"
					fill="#ffffff"
				/>
				<ellipse
					cx="30.5"
					cy="48"
					rx="3.3"
					ry="1.9"
					fill="#fecdd3"
					opacity="0.8"
				/>
				<ellipse
					cx="61.5"
					cy="48"
					rx="3.3"
					ry="1.9"
					fill="#fecdd3"
					opacity="0.8"
				/>
				<circle cx="37" cy="42" r="4.0" fill="#0284c7" />
				<circle cx="55" cy="42" r="4.0" fill="#0284c7" />
				<circle cx="37" cy="42" r="2.1" fill="#0f172a" />
				<circle cx="55" cy="42" r="2.1" fill="#0f172a" />
				<circle cx="38.4" cy="40.4" r="1.35" fill="#ffffff" />
				<circle cx="56.4" cy="40.4" r="1.35" fill="#ffffff" />
				<path
					d="M42 48.5 C42 46.6 50 46.6 50 48.5 C50 50.4 47.5 52.1 46 52.1 C44.5 52.1 42 50.4 42 48.5 Z"
					fill="#18181b"
				/>
				<path
					d="M46 52.1 L46 54.2 M41.6 54 Q43.8 56.4 46 54.2 Q48.2 56.4 50.4 54"
					fill="none"
					stroke="#18181b"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"
				/>
			</g>
		</svg>
	</span>
</button>

<script>
	declare global {
		interface Window {
			__shironeScrollHuskyBound?: boolean;
		}
	}

	const SCROLL_THRESHOLD = 120;

	function syncScrollHusky() {
		const btn = document.getElementById("scroll-husky-btn") as HTMLButtonElement | null;
		if (!btn) return;
		const scrollTop = Math.max(
			window.scrollY || 0,
			document.documentElement.scrollTop || 0,
			document.body.scrollTop || 0,
		);
		const visible = scrollTop > SCROLL_THRESHOLD;
		btn.classList.toggle("is-visible", visible);
		btn.setAttribute("aria-hidden", visible ? "false" : "true");
		btn.tabIndex = visible ? 0 : -1;
	}

	function bindScrollHusky() {
		const btn = document.getElementById("scroll-husky-btn");
		if (btn && !btn.dataset.huskyClickBound) {
			btn.dataset.huskyClickBound = "true";
			btn.addEventListener("click", () => {
				const reduce =
					document.documentElement.classList.contains("motion-reduced") ||
					window.matchMedia("(prefers-reduced-motion: reduce)").matches;
				window.scrollTo({
					top: 0,
					behavior: reduce ? "auto" : "smooth",
				});
			});
		}

		syncScrollHusky();

		if (!window.__shironeScrollHuskyBound) {
			window.__shironeScrollHuskyBound = true;
			window.addEventListener("scroll", syncScrollHusky, { passive: true });
			window.addEventListener("resize", syncScrollHusky, { passive: true });
			document.addEventListener("swup:page:view", syncScrollHusky);
			document.addEventListener("swup:content:replace", syncScrollHusky);
		}
	}

	bindScrollHusky();
</script>

<style lang="stylus">
	.scroll-husky
		position: fixed
		top: 0
		right: 0.25rem
		z-index: 45
		display: flex
		flex-direction: column
		align-items: flex-end
		width: 4.5rem
		height: calc(100vh - 6.75rem)
		max-height: 52rem
		padding: 0
		border: 0
		background: transparent
		pointer-events: none
		opacity: 0
		transform: translateY(-105%)
		transition:
			transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.35s ease

		&.is-visible
			opacity: 1
			transform: translateY(0)

		&__rig
			display: flex
			flex-direction: column
			align-items: flex-end
			width: 100%
			height: 100%
			transform-origin: top right
			animation: scroll-husky-float 3.2s ease-in-out infinite

		&__cord
			flex: 1
			width: 2.5px
			min-height: 3rem
			margin-right: 9.25px
			border-radius: 2px
			background: repeating-linear-gradient(
				to bottom,
				#dc2626 0 7px,
				#27272a 7px 12px
			)
			box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2)
			pointer-events: auto

		&__pet
			flex: none
			margin-top: -1px
			pointer-events: auto
			filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.16))
			transition: transform var(--m3e-duration-short) var(--m3e-easing-standard)

		&:hover &__pet,
		&:focus-visible &__pet
			transform: translateY(-3px) scale(1.06) rotate(-2deg)

		&:focus-visible
			outline: none

		&:focus-visible &__pet
			filter: drop-shadow(0 0 8px var(--primary)) drop-shadow(0 6px 12px rgba(0, 0, 0, 0.2))

	:global(html.dark) .scroll-husky__pet
		filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.45)) drop-shadow(0 6px 14px rgba(0, 0, 0, 0.45))

	@keyframes scroll-husky-float
		0%, 100%
			transform: translateY(0)
		50%
			transform: translateY(-6px)

	@media (max-width: 860px)
		.scroll-husky
			display: none

	:global(html.motion-reduced) .scroll-husky__rig
		animation: none

	@media (prefers-reduced-motion: reduce)
		.scroll-husky__rig
			animation: none
</style>
