---
/** 时间线页：配置层规则在构建期结合数据层传入交互岛，路由负责开关与编排。 */
import TimelineSection from "@components/organisms/TimelineSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nKey, resolveI18nText } from "@utils/i18n-utils";
import { timelineConfig } from "@/config/timelineConfig";
import { resolveTimelineData } from "@/utils/feature-data";

if (!timelineConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(timelineConfig.title, I18nKey.timeline);
const pageTitleKey = resolveI18nKey(timelineConfig.title, I18nKey.timeline);
const pageDescription = resolveI18nText(
	timelineConfig.description,
	I18nKey.timelineBanner,
);
const pageDescriptionKey = resolveI18nKey(
	timelineConfig.description,
	I18nKey.timelineBanner,
);

const items = resolveTimelineData(timelineConfig);
---

<MainGridLayout
	title={pageTitle}
	titleKey={pageTitleKey}
	description={pageDescription}
	descriptionKey={pageDescriptionKey}
	page="timeline"
>
	<TimelineSection
		categories={timelineConfig.categories}
		items={items}
		order={timelineConfig.order ?? "desc"}
		title={pageTitle} titleKey={pageTitleKey}
		subtitle={pageDescription} subtitleKey={pageDescriptionKey}
		client:visible
	/>
</MainGridLayout>
