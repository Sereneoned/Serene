---
import { getImage } from "astro:assets";
import MomentSection from "@components/organisms/MomentSection.svelte";
import UmamiStats from "@components/organisms/UmamiStats.astro";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveImageAsset } from "@utils/asset-utils";
import { getSortedMoments } from "@utils/content-utils";
import { resolveI18nKey, resolveI18nText } from "@utils/i18n-utils";
import { url } from "@utils/url-utils";
import { toWalineInteractionOptions } from "@utils/waline-interactions";
import {
	commentConfig,
	momentsConfig,
	profileConfig,
	resolveCommentOptions,
	resolveUmamiOptions,
	siteConfig,
	umamiConfig,
} from "@/config";

if (!momentsConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(momentsConfig.title, I18nKey.moments);
const pageTitleKey = resolveI18nKey(momentsConfig.title, I18nKey.moments);
const pageDescription = resolveI18nText(
	momentsConfig.description,
	I18nKey.momentsBanner,
);
const pageDescriptionKey = resolveI18nKey(
	momentsConfig.description,
	I18nKey.momentsBanner,
);

const moments = await getSortedMoments();
const avatarAsset = await resolveImageAsset(profileConfig.avatar ?? "");
let avatar =
	typeof avatarAsset === "string"
		? avatarAsset.startsWith("/")
			? url(avatarAsset)
			: avatarAsset
		: avatarAsset.src;
let avatarSrcset: string | undefined;
let avatarWidth: number | undefined;
let avatarHeight: number | undefined;
if (typeof avatarAsset !== "string") {
	const candidates = await Promise.all(
		[64, 96].map(async (width) => ({
			width,
			image: await getImage({
				src: avatarAsset,
				width,
				format: "webp",
				quality: 72,
			}),
		})),
	);
	avatar = candidates[0].image.src;
	avatarSrcset = candidates
		.map(({ image, width }) => `${image.src} ${width}w`)
		.join(", ");
	avatarWidth = avatarAsset.width;
	avatarHeight = avatarAsset.height;
}
const author = {
	name: profileConfig.name,
	avatar,
	avatarSrcset,
	avatarWidth,
	avatarHeight,
	url: url("/about/"),
};
const walineConfig = toWalineInteractionOptions(
	resolveCommentOptions(commentConfig),
	siteConfig.lang,
);
const umamiEnabled = resolveUmamiOptions(umamiConfig) !== null;
---

<MainGridLayout title={pageTitle} titleKey={pageTitleKey} description={pageDescription} descriptionKey={pageDescriptionKey} page="moments">
    <MomentSection
        {moments}
        {author}
        {walineConfig}
        {umamiEnabled}
        basePath={siteConfig.base ?? "/"}
        title={pageTitle}
        titleKey={pageTitleKey}
        subtitle={pageDescription}
        subtitleKey={pageDescriptionKey}
        client:visible
    >
        <UmamiStats variant="meta" path={url("/moments/")} />
    </MomentSection>
</MainGridLayout>
